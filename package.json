{
  "name": "jrxml-editor-extension",
  "displayName": "JRXML Editor",
  "description": "Syntax highlighting, bracket colorization, and expression formatter for JasperReports .jrxml files",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bozduran/jrxml-editor-extension.git"
  },
  "publisher": "BozNtouranLabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "jrxml",
    "jasperreports",
    "jasper",
    "java",
    "expression"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jrxml",
        "aliases": [
          "JRXML",
          "JasperReports XML"
        ],
        "extensions": [
          ".jrxml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jrxml",
        "scopeName": "source.jrxml",
        "path": "./syntaxes/jrxml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jrxml.openExpressionEditor",
        "title": "JRXML: Open Expression Editor",
        "icon": "$(edit)"
      },
      {
        "command": "jrxml.goToDeclaration",
        "title": "JRXML: Go to Declaration"
      },
      {
        "command": "jrxml.refreshBestPractices",
        "title": "JRXML: Refresh Best Practices",
        "icon": "$(refresh)"
      },
      {
        "command": "jrxml.refreshIssues",
        "title": "JRXML: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "jrxml.issues.jumpToHit",
        "title": "JRXML: Go to Issue"
      },
      {
        "command": "jrxml.issues.applyFix",
        "title": "JRXML: Fix Issue",
        "icon": "$(wrench)"
      },
      {
        "command": "jrxml.issues.fixAll",
        "title": "JRXML: Fix All Issues in File",
        "icon": "$(wrench)"
      },
      {
        "command": "jrxml.issues.copyMessage",
        "title": "JRXML: Copy Issue Message"
      },
      {
        "command": "jrxml.issues.copyCode",
        "title": "JRXML: Copy Rule ID"
      },
      {
        "command": "jrxml.nextIssue",
        "title": "JRXML: Go to Next Issue"
      },
      {
        "command": "jrxml.previousIssue",
        "title": "JRXML: Go to Previous Issue"
      },
      {
        "command": "jrxml.bp.suppressRule",
        "title": "JRXML: Suppress Best Practice Rule"
      },
      {
        "command": "jrxml.bp.unsuppressRule",
        "title": "JRXML: Re-enable Best Practice Rule"
      },
      {
        "command": "jrxml.bp.suppressFromTree",
        "title": "JRXML: Suppress Best Practice (hide squiggles)",
        "icon": "$(eye-closed)"
      },
      {
        "command": "jrxml.bp.unsuppressFromTree",
        "title": "JRXML: Re-enable Best Practice squiggles",
        "icon": "$(eye)"
      },
      {
        "command": "jrxml.bp.jumpToHit",
        "title": "JRXML: Jump to Issue"
      },
      {
        "command": "jrxml.sortElements",
        "title": "JRXML: Sort Band/Frame Elements by Position"
      },
      {
        "command": "jrxml.applyClearFixes",
        "title": "JRXML: Apply Clear Fixes (unused declarations, descriptions, jsonql)"
      },
      {
        "command": "jrxml.migrateSqlQuery",
        "title": "JRXML: Migrate SQL Query to jsonql"
      },
      {
        "command": "jrxml.fixAllFormat",
        "title": "JRXML: Fix All (Format and Text)"
      },
      {
        "command": "jrxml.openSettingsPanel",
        "title": "JRXML: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "jrxml.refreshIncludeChain",
        "title": "JRXML: Refresh Include Chain",
        "icon": "$(refresh)"
      }
    ],
    "submenus": [
      {
        "id": "jrxml",
        "label": "JRXML"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "jrxml",
          "when": "resourceExtname == .jrxml",
          "group": "jrxml@1"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "jrxml",
          "when": "resourceExtname == .jrxml",
          "group": "jrxml@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "jrxml",
          "when": "resourceExtname == .jrxml",
          "group": "jrxml@1"
        }
      ],
      "jrxml": [
        {
          "command": "jrxml.openExpressionEditor",
          "group": "1_open@1"
        },
        {
          "command": "jrxml.issues.fixAll",
          "group": "2_fix@1"
        },
        {
          "command": "jrxml.fixAllFormat",
          "group": "2_fix@2"
        },
        {
          "command": "editor.action.formatDocument",
          "group": "2_fix@3"
        },
        {
          "command": "jrxml.applyClearFixes",
          "when": "jrxml.hasClearFixes",
          "group": "3_cleanup@1"
        },
        {
          "command": "jrxml.sortElements",
          "when": "jrxml.hasSortIssue",
          "group": "3_cleanup@2"
        },
        {
          "command": "jrxml.migrateSqlQuery",
          "when": "jrxml.hasSqlMigration",
          "group": "3_cleanup@3"
        },
        {
          "command": "jrxml.nextIssue",
          "group": "4_navigate@1"
        },
        {
          "command": "jrxml.previousIssue",
          "group": "4_navigate@2"
        },
        {
          "command": "jrxml.openSettingsPanel",
          "group": "9_settings@1"
        }
      ],
      "view/title": [
        {
          "command": "jrxml.issues.fixAll",
          "when": "view == jrxmlIssues",
          "group": "navigation"
        },
        {
          "command": "jrxml.refreshIssues",
          "when": "view == jrxmlIssues",
          "group": "navigation"
        },
        {
          "command": "jrxml.refreshBestPractices",
          "when": "view == jrxmlBestPractices",
          "group": "navigation"
        },
        {
          "command": "jrxml.refreshIncludeChain",
          "when": "view == jrxmlIncludeChain",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jrxml.issues.applyFix",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "inline"
        },
        {
          "command": "jrxml.issues.jumpToHit",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "1_open"
        },
        {
          "command": "jrxml.issues.applyFix",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "1_open"
        },
        {
          "command": "jrxml.issues.copyMessage",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "9_copy"
        },
        {
          "command": "jrxml.issues.copyCode",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "9_copy"
        },
        {
          "command": "jrxml.bp.suppressFromTree",
          "when": "view == jrxmlBestPractices && viewItem == bp-rule-suppressible",
          "group": "inline"
        },
        {
          "command": "jrxml.bp.unsuppressFromTree",
          "when": "view == jrxmlBestPractices && viewItem == bp-rule-suppressed",
          "group": "inline"
        },
        {
          "command": "jrxml.sortElements",
          "when": "view == jrxmlBestPractices && viewItem == bp-file-issue-sort",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jrxml.nextIssue",
        "key": "ctrl+alt+down",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jrxml.previousIssue",
        "key": "ctrl+alt+up",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      }
    ],
    "configuration": {
      "title": "JRXML Expression Editor",
      "properties": {
        "jrxml.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Indent size for expression formatting"
        },
        "jrxml.autoOpenEditor": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open expression editor when cursor is inside an expression"
        },
        "jrxml.showUnusedWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for declared fields, parameters, or variables that are never used in any expression."
        },
        "jrxml.validateExpressions": {
          "type": "boolean",
          "default": true,
          "description": "Show errors for unbalanced parentheses, unclosed strings, and undeclared $F/$P/$V references."
        },
        "jrxml.lint.constantPrintWhen": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a <printWhenExpression> is a constant 'true' or 'false'."
        },
        "jrxml.lint.removeLineWhenBlank": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a textField or subreport element is missing removeLineWhenBlank=\"true\"."
        },
        "jrxml.lint.markupTagWithoutMarkup": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a textField expression contains markup tags but markup is not \"styled\", \"html\" or \"rtf\"."
        },
        "jrxml.lint.nullDereference": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a $F/$P/$V reference is used as a method-call receiver without a dominating null check."
        },
        "jrxml.lint.variableOrder": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a variable references another variable declared later (JasperReports evaluates variables in declaration order)."
        },
        "jrxml.format.reportName": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: set jasperReport/@name to the file base name."
        },
        "jrxml.format.positionType": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: add/set positionType=\"Float\" on textField and subreport elements."
        },
        "jrxml.format.textAdjust": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: add/set textAdjust=\"StretchHeight\" on textField elements."
        },
        "jrxml.format.expression": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: normalise operator, ternary, comma and cast spacing inside expressions."
        },
        "jrxml.textcheck.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Text check: replace unrenderable characters, fix period spacing, collapse double spaces and normalize newlines in text and string literals."
        },
        "jrxml.textcheck.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings with quick fixes for text-check problems (double spaces, missing space after '.', unrenderable characters, newlines) in <text> CDATA and string literals."
        },
        "jrxml.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run the format + textcheck steps when saving a .jrxml file (never the clear or sort steps)."
        },
        "jrxml.sort.preview": {
          "type": "boolean",
          "default": true,
          "description": "Show a diff and ask for confirmation before applying the geometry sort (the sort rewrites the whole file)."
        },
        "jrxml.clear.preview": {
          "type": "boolean",
          "default": true,
          "description": "Show a diff and ask for confirmation before applying clear fixes or a SQL->jsonql migration."
        },
        "jrxml.migrate.targetLanguage": {
          "type": "string",
          "default": "jsonql",
          "description": "Language written to <query language=\"...\"> when migrating a SQL query."
        },
        "jrxml.suppressedBestPractices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of best practice rule IDs whose yellow squiggles are hidden. Quick fixes remain available."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "jrxmlIssues",
          "name": "Issues (JRXML)",
          "icon": "$(warning)",
          "contextualTitle": "JRXML Issues"
        },
        {
          "id": "jrxmlBestPractices",
          "name": "Best Practices (JRXML)",
          "icon": "$(lightbulb)",
          "contextualTitle": "JRXML Best Practices"
        },
        {
          "id": "jrxmlIncludeChain",
          "name": "Include Chain (JRXML)",
          "icon": "$(references)",
          "contextualTitle": "JRXML Include Chain"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "test:integration": "vscode-test",
    "lint": "eslint .",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  }
}
