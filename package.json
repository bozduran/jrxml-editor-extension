{
  "name": "jrxml-editor-extension",
  "displayName": "JRXML Editor",
  "description": "JasperReports JRXML authoring: expressions, diagnostics, design view, resource bundles, queries and workspace validation.",
  "version": "1.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bozduran/jrxml-editor-extension.git"
  },
  "publisher": "BozNtouranLabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Other"
  ],
  "keywords": [
    "jrxml",
    "jasperreports",
    "jasper",
    "java",
    "expression",
    "report",
    "design-view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jrxml",
        "aliases": [
          "JRXML",
          "JasperReports XML"
        ],
        "extensions": [
          ".jrxml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jrxml",
        "scopeName": "source.jrxml",
        "path": "./syntaxes/jrxml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jrxml.openDesignView",
        "title": "JRXML: Open Design View",
        "icon": "$(preview)"
      },
      {
        "command": "jrxml.openExpressionEditor",
        "title": "JRXML: Open Expression Editor",
        "icon": "$(edit)"
      },
      {
        "command": "jrxml.openIfElseBuilder",
        "title": "JRXML: Open If / Else Builder",
        "icon": "$(list-tree)"
      },
      {
        "command": "jrxml.goToDeclaration",
        "title": "JRXML: Go to Declaration"
      },
      {
        "command": "jrxml.refreshIssues",
        "title": "JRXML: Refresh Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "jrxml.issues.jumpToHit",
        "title": "JRXML: Go to Issue"
      },
      {
        "command": "jrxml.issues.applyFix",
        "title": "JRXML: Fix Issue",
        "icon": "$(wrench)"
      },
      {
        "command": "jrxml.issues.fixAll",
        "title": "JRXML: Fix All Issues in File",
        "icon": "$(wrench)"
      },
      {
        "command": "jrxml.issues.copyMessage",
        "title": "JRXML: Copy Issue Message"
      },
      {
        "command": "jrxml.issues.copyCode",
        "title": "JRXML: Copy Rule ID"
      },
      {
        "command": "jrxml.issues.editInExpressionEditor",
        "title": "JRXML: Edit Issue in Expression Editor"
      },
      {
        "command": "jrxml.issues.editInIfElseBuilder",
        "title": "JRXML: Edit Issue in If / Else Builder"
      },
      {
        "command": "jrxml.nextIssue",
        "title": "JRXML: Go to Next Issue"
      },
      {
        "command": "jrxml.previousIssue",
        "title": "JRXML: Go to Previous Issue"
      },
      {
        "command": "jrxml.sortElements",
        "title": "JRXML: Sort Band/Frame Elements by Position"
      },
      {
        "command": "jrxml.applyClearFixes",
        "title": "JRXML: Apply Clear Fixes (unused declarations, descriptions, jsonql)"
      },
      {
        "command": "jrxml.migrateSqlQuery",
        "title": "JRXML: Migrate SQL Query to jsonql"
      },
      {
        "command": "jrxml.fixAllFormat",
        "title": "JRXML: Fix All (Format and Text)"
      },
      {
        "command": "jrxml.formatDocument",
        "title": "JRXML: Format Document"
      },
      {
        "command": "jrxml.formatExpressionAtCursor",
        "title": "JRXML: Format Expression at Cursor",
        "icon": "$(wand)"
      },
      {
        "command": "jrxml.openSettingsPanel",
        "title": "JRXML: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "jrxml.openTutorial",
        "title": "JRXML: Open Tutorial",
        "icon": "$(book)"
      },
      {
        "command": "jrxml.refreshIncludeChain",
        "title": "JRXML: Refresh Include Chain",
        "icon": "$(refresh)"
      },
      {
        "command": "jrxml.validateWorkspace",
        "title": "JRXML: Validate Workspace",
        "icon": "$(check-all)"
      },
      {
        "command": "jrxml.runBuild",
        "title": "JRXML: Run Build",
        "icon": "$(play)"
      }
    ],
    "submenus": [
      {
        "id": "jrxml",
        "label": "JRXML"
      }
    ],
    "problemMatchers": [
      {
        "name": "jrxml-file-line",
        "owner": "jrxml",
        "source": "JasperReports",
        "applyTo": "allDocuments",
        "pattern": {
          "regexp": "^\\[ERROR\\]\\s+(.+?\\.jrxml):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      {
        "name": "jrxml-javac",
        "owner": "jrxml",
        "source": "JasperReports",
        "applyTo": "allDocuments",
        "pattern": {
          "regexp": "^(?!\\[ERROR\\])\\s*(.+?\\.jrxml):(\\d+):\\s*(?:error:\\s*)?(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      {
        "name": "jrxml-compile",
        "owner": "jrxml",
        "source": "JasperReports",
        "applyTo": "allDocuments",
        "pattern": {
          "regexp": "^\\s*(?:\\d+\\.\\s+)?ERROR in\\s+(.+?\\.jrxml)\\s+\\(at line (\\d+)\\)\\s*$",
          "file": 1,
          "line": 2,
          "message": "JasperReports compile error"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "jrxml",
          "when": "resourceExtname == .jrxml",
          "group": "jrxml@1"
        }
      ],
      "editor/title": [
        {
          "command": "jrxml.openDesignView",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@0"
        },
        {
          "command": "jrxml.openExpressionEditor",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@1"
        },
        {
          "command": "jrxml.openIfElseBuilder",
          "when": "resourceExtname == .jrxml",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "jrxml",
          "when": "resourceExtname == .jrxml",
          "group": "jrxml@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "jrxml",
          "when": "resourceExtname == .jrxml",
          "group": "jrxml@1"
        }
      ],
      "jrxml": [
        {
          "command": "jrxml.openDesignView",
          "group": "0_view@1"
        },
        {
          "command": "jrxml.openExpressionEditor",
          "group": "1_open@1"
        },
        {
          "command": "jrxml.openIfElseBuilder",
          "group": "1_open@2"
        },
        {
          "command": "jrxml.issues.fixAll",
          "group": "2_fix@1"
        },
        {
          "command": "jrxml.fixAllFormat",
          "group": "2_fix@2"
        },
        {
          "command": "jrxml.formatDocument",
          "group": "2_fix@3"
        },
        {
          "command": "jrxml.formatExpressionAtCursor",
          "group": "2_fix@4"
        },
        {
          "command": "jrxml.applyClearFixes",
          "when": "jrxml.hasClearFixes",
          "group": "3_cleanup@1"
        },
        {
          "command": "jrxml.sortElements",
          "when": "jrxml.hasSortIssue",
          "group": "3_cleanup@2"
        },
        {
          "command": "jrxml.migrateSqlQuery",
          "when": "jrxml.hasSqlMigration",
          "group": "3_cleanup@3"
        },
        {
          "command": "jrxml.nextIssue",
          "group": "4_navigate@1"
        },
        {
          "command": "jrxml.previousIssue",
          "group": "4_navigate@2"
        },
        {
          "command": "jrxml.validateWorkspace",
          "group": "5_validate@1"
        },
        {
          "command": "jrxml.runBuild",
          "group": "6_build@1"
        },
        {
          "command": "jrxml.openSettingsPanel",
          "group": "9_settings@1"
        },
        {
          "command": "jrxml.openTutorial",
          "group": "9_settings@2"
        }
      ],
      "view/title": [
        {
          "command": "jrxml.issues.fixAll",
          "when": "view == jrxmlIssues",
          "group": "navigation"
        },
        {
          "command": "jrxml.refreshIssues",
          "when": "view == jrxmlIssues",
          "group": "navigation"
        },
        {
          "command": "jrxml.refreshIncludeChain",
          "when": "view == jrxmlIncludeChain",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "jrxml.issues.editInExpressionEditor",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "1_open@1"
        },
        {
          "command": "jrxml.issues.editInIfElseBuilder",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "1_open@2"
        },
        {
          "command": "jrxml.issues.applyFix",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "inline"
        },
        {
          "command": "jrxml.issues.jumpToHit",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "1_open"
        },
        {
          "command": "jrxml.issues.applyFix",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "1_open"
        },
        {
          "command": "jrxml.issues.copyMessage",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "9_copy"
        },
        {
          "command": "jrxml.issues.copyCode",
          "when": "view == jrxmlIssues && viewItem == jrxmlIssueDiagnostic",
          "group": "9_copy"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jrxml.openExpressionEditor",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jrxml.openIfElseBuilder",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus && resourceExtname == .jrxml"
      },
      {
        "command": "jrxml.nextIssue",
        "key": "ctrl+alt+n",
        "when": "editorTextFocus && resourceExtname == .jrxml",
        "mac": "cmd+alt+n"
      },
      {
        "command": "jrxml.previousIssue",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus && resourceExtname == .jrxml",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "JRXML Expression Editor",
      "properties": {
        "jrxml.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Indent size for expression formatting"
        },
        "jrxml.autoOpenEditor": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open expression editor when cursor is inside an expression"
        },
        "jrxml.expressionEditor.autoFormat": {
          "type": "boolean",
          "default": false,
          "description": "Remember the Expression Editor's \"Auto-format on change\" setting."
        },
        "jrxml.ifElse.nullSafe": {
          "type": "boolean",
          "default": true,
          "description": "Start the If / Else builder with null-safe guards."
        },
        "jrxml.ifElse.multiline": {
          "type": "boolean",
          "default": true,
          "description": "Start the If / Else builder with multi-line output."
        },
        "jrxml.ifElse.style": {
          "type": "string",
          "enum": [
            "ternary",
            "functions"
          ],
          "enumDescriptions": [
            "Nested ternary: (condition ? value : value)",
            "Jaspersoft functions: IF() / AND() / OR()"
          ],
          "default": "ternary",
          "description": "Default output style of the If / Else builder."
        },
        "jrxml.typeCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Suggest the Java members of a field, parameter or variable type after a '.' (for example $F{customer}.get)."
        },
        "jrxml.typeCompletion.jdkBaseline": {
          "type": "string",
          "enum": [
            "8",
            "11",
            "17",
            "21"
          ],
          "enumDescriptions": [
            "Java 8 — JasperReports 6.x default",
            "Java 11 — JasperReports 7.x default",
            "Java 17",
            "Java 21"
          ],
          "default": "8",
          "description": "Java version the reports are compiled against. Members added later (String.isBlank, List.getFirst, ...) are not suggested."
        },
        "jrxml.showUnusedWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for declared fields, parameters, or variables that are never used in any expression."
        },
        "jrxml.validateExpressions": {
          "type": "boolean",
          "default": true,
          "description": "Show errors for unbalanced parentheses, unclosed strings, and undeclared $F/$P/$V references."
        },
        "jrxml.lint.constantPrintWhen": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a <printWhenExpression> is a constant 'true' or 'false'."
        },
        "jrxml.lint.removeLineWhenBlank": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a textField or subreport element is missing removeLineWhenBlank=\"true\"."
        },
        "jrxml.lint.markupTagWithoutMarkup": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a textField expression contains markup tags but markup is not \"styled\", \"html\" or \"rtf\"."
        },
        "jrxml.lint.nullDereference": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a $F/$P/$V reference is used as a method-call receiver without a dominating null check."
        },
        "jrxml.lint.variableOrder": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a variable references another variable declared later (JasperReports evaluates variables in declaration order)."
        },
        "jrxml.lint.booleanEquals": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a Boolean field, parameter or variable is compared with == / != or Boolean.TRUE/FALSE.equals instead of EQUALS()."
        },
        "jrxml.lint.duplicateNames": {
          "type": "boolean",
          "default": true,
          "description": "Error when a field, parameter, variable, group, dataset or style name is declared more than once in the same scope."
        },
        "jrxml.lint.layout": {
          "type": "boolean",
          "default": true,
          "description": "Error when columns do not fit the page, band heights exceed the margins, or an element extends below its band."
        },
        "jrxml.lint.queries": {
          "type": "boolean",
          "default": true,
          "description": "Warn about an unclosed string literal or block comment inside <query> content."
        },
        "jrxml.build.command": {
          "type": "string",
          "default": "mvn -q -DskipTests jasperreports:compile",
          "description": "Shell command run by JRXML: Run Build. Its output is parsed by the contributed $jrxml-* problem matchers."
        },
        "jrxml.format.reportName": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: set jasperReport/@name to the file base name."
        },
        "jrxml.format.positionType": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: add/set positionType=\"Float\" on textField and subreport elements."
        },
        "jrxml.format.textAdjust": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: add/set textAdjust=\"StretchHeight\" on textField elements."
        },
        "jrxml.format.expression": {
          "type": "boolean",
          "default": true,
          "description": "Formatting: normalise operator, ternary, comma and cast spacing inside expressions."
        },
        "jrxml.textcheck.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Text check: replace unrenderable characters, fix period spacing, collapse double spaces and normalize newlines in text and string literals."
        },
        "jrxml.textcheck.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings with quick fixes for text-check problems (double spaces, missing space after '.', unrenderable characters, newlines) in <text> CDATA and string literals."
        },
        "jrxml.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run the format + textcheck steps when saving a .jrxml file (never the clear or sort steps)."
        },
        "jrxml.sort.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before applying the geometry sort (the command always opens a diff preview; the sort rewrites the whole file)."
        },
        "jrxml.clear.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before applying clear fixes or a SQL->jsonql migration (the command always opens a diff preview)."
        },
        "jrxml.migrate.targetLanguage": {
          "type": "string",
          "default": "jsonql",
          "description": "Language written to <query language=\"...\"> when migrating a SQL query."
        }
      }
    },
    "snippets": [
      {
        "language": "jrxml",
        "path": "./snippets/jrxml.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jrxmlViews",
          "title": "JRXML",
          "icon": "media/jrxml.svg"
        }
      ]
    },
    "views": {
      "jrxmlViews": [
        {
          "id": "jrxmlIssues",
          "name": "Issues (JRXML)",
          "icon": "$(warning)",
          "contextualTitle": "JRXML Issues"
        },
        {
          "id": "jrxmlIncludeChain",
          "name": "Include Chain (JRXML)",
          "icon": "$(references)",
          "contextualTitle": "JRXML Include Chain"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jrxmlIssues",
        "contents": "Open a `.jrxml` file to see diagnostics here.\n[Open Expression Editor](command:jrxml.openExpressionEditor)\n[Build an if / else expression](command:jrxml.openIfElseBuilder)\n[Open Settings](command:jrxml.openSettingsPanel)\n[Open the tutorial](command:jrxml.openTutorial)"
      }
    ],
    "walkthroughs": [
      {
        "id": "jrxml.getStarted",
        "title": "Get started with JRXML",
        "description": "Open, format, navigate and fix JasperReports expressions.",
        "steps": [
          {
            "id": "jrxml.getStarted.openExpression",
            "title": "Open an expression",
            "description": "Place the cursor inside an expression tag, then use **JRXML: Open Expression Editor** or click the pencil icon in the editor title bar. `Ctrl+Alt+E` works too.",
            "media": {
              "markdown": "media/walkthrough/open-expression.md"
            },
            "completionEvents": [
              "onCommand:jrxml.openExpressionEditor"
            ]
          },
          {
            "id": "jrxml.getStarted.formatExpression",
            "title": "Format one expression",
            "description": "Run **JRXML: Format Expression at Cursor** to format only the expression under the cursor, without touching the rest of the file.",
            "media": {
              "markdown": "media/walkthrough/format-expression.md"
            },
            "completionEvents": [
              "onCommand:jrxml.formatExpressionAtCursor"
            ]
          },
          {
            "id": "jrxml.getStarted.fixIssues",
            "title": "Fix issues from the JRXML view",
            "description": "The **JRXML** Activity Bar view lists issues for the open report. Open an issue's expression in the editor or builder from its context menu.",
            "media": {
              "markdown": "media/walkthrough/fix-issues.md"
            }
          },
          {
            "id": "jrxml.getStarted.buildIfElse",
            "title": "Build if / else visually",
            "description": "Use **JRXML: Open If / Else Builder** (`Ctrl+Alt+B`) to turn the expression under the cursor into branches, then apply it back.",
            "media": {
              "markdown": "media/walkthrough/build-if-else.md"
            },
            "completionEvents": [
              "onCommand:jrxml.openIfElseBuilder"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/watch.mjs",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test test/",
    "test:integration": "npm run build && vscode-test",
    "test:integration:headless": "npm run build && vscode-test --config .vscode-test.headless.mjs",
    "lint": "eslint .",
    "validate:workspace": "npm run build && node out/tools/validate-workspace.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "version": "npm run build && node out/tools/update-changelog.js && git add CHANGELOG.md",
    "gen:jdk-index": "npm run build && node out/tools/gen-jdk-index.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.2",
    "eslint": "^9.0.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@vscode/test-cli": {
      "glob": "14.0.5",
      "minimatch": "11.0.8"
    },
    "@vscode/vsce": {
      "glob": "14.0.5",
      "minimatch": "11.0.8"
    },
    "mocha": {
      "glob": "14.0.5",
      "minimatch": "11.0.8",
      "serialize-javascript": "7.1.4",
      "diff": "9.0.0"
    },
    "test-exclude": {
      "glob": "14.0.5",
      "minimatch": "11.0.8"
    }
  }
}
